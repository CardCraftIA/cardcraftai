# Only TEST/Preview until release approval. Never put server secrets in NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing provider is preserved until a staged, evaluated replacement is ready.
# Values: gemini (default), openai-compatible, disabled.
ATLAS_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# For an authenticated HTTPS vLLM/llama.cpp-compatible server, including /v1.
# Text-only integration. No automatic fallback to Gemini if selected.
ATLAS_LLM_BASE_URL=
ATLAS_LLM_API_KEY=
ATLAS_LLM_MODEL=
